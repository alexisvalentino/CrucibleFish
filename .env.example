# Optional server-side credentials. Browser settings take precedence for each request.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
# Lower this to 10 if your provider resets long swarm requests (default 20).
SWARM_BATCH_SIZE=10
# Run swarm batches one at a time if the provider resets concurrent requests.
SWARM_CONCURRENCY=1
# Official default: https://api.openai.com/v1
OPENAI_BASE_URL=
PORT=4740
